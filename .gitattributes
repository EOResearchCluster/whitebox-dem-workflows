# Set default behavior to automatically normalize line endings
* text=auto

# Python files should always use LF
*.py text eol=lf

# Shell scripts (archived) should use LF
*.sh text eol=lf

# Configuration files
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Binary files
*.tif binary
*.tiff binary
*.png binary
*.jpg binary
*.jpeg binary
*.shp binary
*.shx binary
*.dbf binary
